---
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import { tagClass } from '../../lib/tags';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const base = import.meta.env.BASE_URL;
const url = new URL(Astro.request.url);
const activeTag = url.searchParams.get('tag') || '';

const allPosts = await getCollection('posts');
let posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
if (activeTag) {
  posts = posts.filter((p) => p.data.tags.includes(activeTag));
}
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="文章" description="成馨的技术笔记与复盘思考">
  <div class="container">
    <div class="page-head fade-up">
      <p class="eyebrow">文章</p>
      <h1>技术文章</h1>
      <p class="section-desc">
        项目踩坑、技术笔记与复盘思考。沉淀是为了更好地出发。
      </p>
    </div>

    <div class="tag-cloud fade-up">
      {allTags.map((tag) => <span class={tagClass(tag)}>{tag}</span>)}
    </div>

    <p class="count muted">共 {posts.length} 篇文章</p>

    <div class="grid grid-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    {posts.length === 0 && (
      <div class="empty">
        <p class="muted">没有符合该标签的文章。</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-head { margin-bottom: var(--space-8); }
  .page-head h1 { margin: var(--space-1) 0 var(--space-4); }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-4);
  }
  .count { font-size: 0.82rem; margin-bottom: var(--space-6); }
  .empty {
    text-align: center;
    padding: var(--space-16);
  }
</style>
