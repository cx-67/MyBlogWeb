---
import { withBase, assetUrl } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const profile = {
  name: '成馨',
  education: '南京大学 | 软件工程 | 本科 | 2023.09 – 2027.06 | GPA 4.17/5.0 | CET-6 505',
  title: '后端开发 · 售前解决方案 · 2027 届秋招',
};

const skills = [
  { category: '编程语言', items: ['Python', 'Java', 'C++', 'JavaScript'] },
  { category: '后端框架', items: ['Spring Boot', 'Flask', 'MyBatis', 'RESTful API', 'SSE'] },
  { category: '数据库与缓存', items: ['MySQL', 'Redis', 'SQLite', 'Kafka', 'ChromaDB'] },
  { category: 'LLM 工程化', items: ['RAG', 'ReAct Agent', 'Function Calling', 'DeepSeek', 'OpenAI', '智谱'] },
  { category: '工程化', items: ['Docker', 'Git', 'AOP', 'RBAC', 'JWT'] },
  { category: '产品与方案', items: ['商业模式画布', '移情图', '接口文档', '数据库设计', '飞书 Wiki'] },
];

const timeline = [
  {
    period: '2023.09 – 2027.06',
    title: '南京大学 · 软件工程（本科）',
    desc: 'GPA 4.17/5.0，CET-6 505。系统学习数据结构、操作系统、数据库、分布式系统等核心课程，可流畅阅读英文技术文档。',
  },
  {
    period: '2023.10 – 2023.12',
    title: '伴侣型 AI 行业研究 · 团队合作',
    desc: '用技术采纳生命周期模型分析 10+ 款 AI 伴侣产品（Replika / Character.AI），研究内容引用了《软件学报》文献。',
  },
  {
    period: '2024.04 – 2024.06',
    title: 'Pop-go 社交电商平台 · 商业模式设计',
    desc: '通过移情图洞察 KPOP 爱好者/原创商家三类用户痛点，完成 9 大模块商业模式画布与 15 个模块关联设计。',
  },
  {
    period: '2025.11 – 2026.01',
    title: '学生信息管理系统 · 安全与部署负责人',
    desc: 'Spring Boot + Redis + Kafka + Docker。Spring Security + JWT 无状态登录、RBAC 权限、Token 黑名单；Redis 缓存降低查询延迟 30%。',
  },
  {
    period: '2026.03 – 至今',
    title: '智能备考 Agent 平台 · AI 产品化后端负责人',
    desc: '6 人团队，独立交付 4500 行 Python 后端。设计 ReAct 推理循环、RAG 全链路、7 工具 Function Calling、6 库分离架构。',
  },
];

const campus = [
  {
    period: '2024 – 2025',
    org: '南京大学软件学院学生会 · 综合联络中心',
    role: '骨干',
    desc: '拉取赞助，统筹活动物资，协调部门事务。',
  },
  {
    period: '2024 – 至今',
    org: '反哺学社',
    role: '社员',
    desc: '参与策划春季活动，负责后勤与数据统计。',
  },
];

const resumes = [
  { name: '后端简历', desc: '面向后端开发岗位，强调技术栈与项目架构。', path: '/files/resume-backend.docx' },
  { name: '售前简历', desc: '面向售前/解决方案岗，强调产品方法论与方案输出。', path: '/files/resume-presales.docx' },
];

const certificates = [
  { name: '华为开发者学堂专业证书', detail: 'HarmonyOS 应用开发者基础认证', date: '2025.09', img: '/images/certificates/华为证书.jpg' },
  { name: '南星梦想计划优秀志愿者', detail: '千名优秀学子回访母校实践活动', date: '2024.03', img: '/images/certificates/优秀志愿者证书.jpg' },
  { name: '学生会任职证明', detail: '南京大学软件学院 · 综合联络中心骨干', date: '2024-2025', img: '/images/certificates/学生会任职证明.jpg' },
];

// 标签页配置
const tabs = [
  { id: 'overview', label: '概览' },
  { id: 'timeline', label: '经历' },
  { id: 'campus', label: '校园' },
  { id: 'resume', label: '简历' },
  { id: 'honors', label: '荣誉' },
  { id: 'contact', label: '联系' },
];
---

<BaseLayout title="关于" description="成馨 · 个人简介、经历与荣誉">
  <div class="container">
    <!-- 个人信息（极简） -->
    <section class="profile fade-up">
      <h1>{profile.name}</h1>
      <p class="profile-edu">{profile.education}</p>
      <p class="profile-title">{profile.title}</p>
      <div class="profile-actions">
        <a href="https://github.com/cx-67" target="_blank" rel="noopener" class="btn btn-soft">GitHub →</a>
      </div>
    </section>

    <div class="divider"></div>

    <!-- 标签导航 -->
    <nav class="tabs" id="about-tabs" role="tablist">
      {tabs.map((tab, i) => (
        <button
          class:list={['tab', { active: i === 0 }]}
          data-tab={tab.id}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {tab.label}
        </button>
      ))}
    </nav>

    <!-- 标签内容 -->
    <div class="tab-panels">
      <!-- 概览：技能 -->
      <section class="tab-panel active" data-panel="overview" role="tabpanel">
        <h2 class="section-title">技术栈</h2>
        <div class="skills">
          {skills.map((group) => (
            <div class="skill-group">
              <p class="skill-cat">{group.category}</p>
              <div class="tags">
                {group.items.map((item) => <span class="tag">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 经历：项目/研究时间线 -->
      <section class="tab-panel" data-panel="timeline" role="tabpanel" hidden>
        <h2 class="section-title">项目 / 研究时间线</h2>
        <div class="timeline">
          {timeline.map((item) => (
            <div class="timeline-item">
              <div class="tl-dot"></div>
              <div class="tl-content">
                <p class="tl-period">{item.period}</p>
                <h3 class="tl-title">{item.title}</h3>
                <p class="tl-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 校园经历 -->
      <section class="tab-panel" data-panel="campus" role="tabpanel" hidden>
        <h2 class="section-title">校园经历</h2>
        <div class="timeline">
          {campus.map((item) => (
            <div class="timeline-item">
              <div class="tl-dot tl-dot-muted"></div>
              <div class="tl-content">
                <p class="tl-period">{item.period} · {item.role}</p>
                <h3 class="tl-title">{item.org}</h3>
                <p class="tl-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 简历：两个下载项 -->
      <section class="tab-panel" data-panel="resume" role="tabpanel" hidden>
        <h2 class="section-title">简历下载</h2>
        <p class="section-desc">按投递方向选择对应版本。</p>
        <div class="resume-list">
          {resumes.map((r) => (
            <a href={assetUrl(r.path, base)} class="resume-item" download>
              <div class="resume-info">
                <p class="resume-name">{r.name}</p>
                <p class="resume-desc">{r.desc}</p>
              </div>
              <span class="resume-arrow">↓</span>
            </a>
          ))}
        </div>
      </section>

      <!-- 荣誉：大图堆叠 -->
      <section class="tab-panel" data-panel="honors" role="tabpanel" hidden>
        <h2 class="section-title">证书与荣誉</h2>
        <p class="section-desc">共 {certificates.length} 项。点击图片可查看完整原图。</p>
        <div class="certs">
          {certificates.map((cert) => (
            <figure class="cert">
              <a href={assetUrl(cert.img, base)} target="_blank" rel="noopener" class="cert-link">
                <img src={assetUrl(cert.img, base)} alt={cert.name} loading="lazy" />
              </a>
              <figcaption>
                <p class="cert-name">{cert.name}</p>
                <p class="cert-detail">{cert.detail}</p>
                <p class="cert-date muted">{cert.date}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 联系：邮箱 + 电话 -->
      <section class="tab-panel" data-panel="contact" role="tabpanel" hidden>
        <h2 class="section-title">联系方式</h2>
        <div class="contact-list">
          <div class="contact-row">
            <span class="contact-label">邮箱</span>
            <span class="contact-value">231250056@smail.nju.edu.cn</span>
          </div>
          <div class="contact-row">
            <span class="contact-label">电话</span>
            <span class="contact-value">18251260920</span>
          </div>
          <div class="contact-row">
            <span class="contact-label">GitHub</span>
            <a href="https://github.com/cx-67" target="_blank" rel="noopener" class="contact-value">@cx-67 →</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .profile {
    padding: var(--space-4) 0 var(--space-6);
  }
  .profile h1 { margin-bottom: var(--space-2); }
  .profile-edu {
    color: var(--color-text-soft);
    font-size: 0.9rem;
    margin-bottom: var(--space-1);
    line-height: 1.6;
  }
  .profile-title {
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-4);
    font-size: 0.95rem;
  }
  .profile-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* 标签页导航 */
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-text-soft);
    padding: 10px 16px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--transition), border-color var(--transition);
    white-space: nowrap;
  }
  .tab:hover { color: var(--color-text); }
  .tab.active {
    color: var(--color-text);
    font-weight: 600;
    border-bottom-color: var(--color-accent);
  }

  .tab-panels { position: relative; }
  .tab-panel[hidden] { display: none; }
  .tab-panel {
    animation: fadeIn 0.25s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .tab-panel h2 { margin-bottom: var(--space-4); }

  /* 技能 */
  .skills {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .skill-cat {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* 时间线 */
  .timeline {
    position: relative;
    padding-left: 24px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-border-strong);
  }
  .timeline-item {
    position: relative;
    margin-bottom: var(--space-6);
  }
  .tl-dot {
    position: absolute;
    left: -24px;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
  }
  .tl-dot-muted { border-color: var(--color-text-muted); }
  .tl-period {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    margin-bottom: var(--space-1);
  }
  .tl-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .tl-desc {
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  /* 简历列表 */
  .resume-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .resume-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    transition: border-color var(--transition), background var(--transition);
  }
  .resume-item:hover {
    color: inherit;
    border-color: var(--color-accent);
    background: var(--color-bg-soft);
  }
  .resume-name { font-weight: 600; font-size: 1rem; margin-bottom: 2px; }
  .resume-desc { color: var(--color-text-soft); font-size: 0.85rem; }
  .resume-arrow {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1.2rem;
  }

  /* 荣誉大图堆叠 */
  .certs {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .cert {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cert-link {
    display: block;
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: zoom-in;
    border: 1px solid var(--color-border);
    transition: border-color var(--transition);
  }
  .cert-link:hover { border-color: var(--color-border-strong); }
  .cert-link img {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    display: block;
    background: #fff;
  }
  .cert-name { font-weight: 600; font-size: 0.95rem; margin-top: 2px; }
  .cert-detail { font-size: 0.85rem; color: var(--color-text-soft); }
  .cert-date { font-size: 0.78rem; font-family: var(--font-mono); }

  /* 联系 */
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .contact-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .contact-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    width: 70px;
    flex-shrink: 0;
  }
  .contact-value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
  }
  a.contact-value:hover { color: var(--color-accent); }
</style>

<script>
  // 标签页切换
  const tabContainer = document.getElementById('about-tabs');
  const tabs = tabContainer?.querySelectorAll<HTMLButtonElement>('.tab') ?? [];
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  function activate(targetId: string) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === targetId;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', String(on));
    });
    panels.forEach((p) => {
      const on = p.dataset.panel === targetId;
      p.hidden = !on;
      p.classList.toggle('active', on);
    });
    // 更新 URL hash，便于刷新保留状态
    history.replaceState(null, '', '#' + targetId);
  }

  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      if (t.dataset.tab) activate(t.dataset.tab);
    });
  });

  // 初始根据 hash 激活
  const initial = location.hash.replace('#', '') || 'overview';
  if ([...tabs].some((t) => t.dataset.tab === initial)) {
    activate(initial);
  }
</script>
