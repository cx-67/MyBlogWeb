---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="页面未找到">
  <div class="container">
    <div class="not-found fade-up">
      <div class="big">404</div>
      <p class="muted">这个页面好像走丢了</p>
      <a href={withBase('', base)} class="btn btn-primary">回到首页</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: var(--space-20) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .big {
    font-size: 4rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.03em;
  }
</style>
