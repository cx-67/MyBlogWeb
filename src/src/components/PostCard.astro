---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { data } = post;
const base = import.meta.env.BASE_URL;
const href = withBase(`posts/${post.slug}`, base);
---

<a href={href} class="card card-link post-card fade-up">
  <div class="meta">
    <span class="date">{data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
  </div>
  <h3 class="title">{data.title}</h3>
  <p class="desc">{data.description}</p>
  <div class="tags">
    {data.tags.map((tag, i) => <span class={`tag tag-${(i % 5) + 1}`}>{tag}</span>)}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .title {
    font-size: 1.05rem;
    line-height: 1.4;
    font-weight: 600;
  }
  .desc {
    color: var(--color-text-soft);
    font-size: 0.88rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-1);
  }
</style>
