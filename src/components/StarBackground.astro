---
// 手绘星空背景组件
// 星星、月亮、小云朵 — 简笔画卡通风格
// 使用 Canvas 2D 渲染，轻量高性能
---

<canvas id="star-canvas" class="star-canvas"></canvas>

<script>
  (function() {
    const canvas = document.getElementById('star-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let items = [];
    let animationId = null;
    let isActive = true;
    let dpr = window.devicePixelRatio || 1;

    // 莫兰迪色系 — 温馨低饱和
    const colors = {
      star: 'rgba(215, 179, 190, 0.5)',      // 莫兰迪粉 #d7b3be
      starBright: 'rgba(235, 226, 170, 0.7)', // 暖黄 #EBE2AA
      moon: 'rgba(171, 181, 192, 0.25)',      // 灰蓝 #ABB5C0
      cloud: 'rgba(177, 222, 220, 0.15)',     // 薄荷 #B1DEDC
      twinkle: 'rgba(213, 170, 167, 0.4)',    // 暖棕 #D5AAA7
    };

    // 手绘星星路径（四角星，简笔画风格）
    function drawHandDrawnStar(cx, cy, r, rotation, opacity) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(rotation);
      ctx.beginPath();
      // 手绘感：用贝塞尔曲线画四角星，带点不规则
      const spikes = 4;
      const innerR = r * 0.4;
      for (let i = 0; i < spikes * 2; i++) {
        const angle = (i * Math.PI) / spikes - Math.PI / 2;
        const radius = i % 2 === 0 ? r : innerR;
        // 添加微小随机偏移，制造手绘感
        const jitter = (Math.sin(i * 3.7 + cx) * 0.15);
        const x = Math.cos(angle) * radius * (1 + jitter);
        const y = Math.sin(angle) * radius * (1 + jitter);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.fillStyle = `rgba(215, 179, 190, ${opacity})`;
      ctx.fill();
      ctx.restore();
    }

    // 手绘月亮（弯弯的月牙，简笔画）
    function drawHandDrawnMoon(x, y, size) {
      ctx.save();
      ctx.beginPath();
      // 外弧
      ctx.arc(x, y, size, -Math.PI * 0.7, Math.PI * 0.3, false);
      // 内弧（月牙缺口）
      ctx.arc(x + size * 0.35, y - size * 0.1, size * 0.75, Math.PI * 0.2, -Math.PI * 0.6, true);
      ctx.closePath();
      ctx.fillStyle = colors.moon;
      ctx.fill();
      ctx.restore();
    }

    // 小云朵（简笔画圆点组合）
    function drawLittleCloud(x, y, scale) {
      ctx.save();
      const circles = [
        { dx: 0, dy: 0, r: 6 },
        { dx: 8, dy: -3, r: 5 },
        { dx: -7, dy: -2, r: 4.5 },
        { dx: 4, dy: 4, r: 4 },
      ];
      circles.forEach(c => {
        ctx.beginPath();
        ctx.arc(x + c.dx * scale, y + c.dy * scale, c.r * scale, 0, Math.PI * 2);
        ctx.fillStyle = colors.cloud;
        ctx.fill();
      });
      ctx.restore();
    }

    // 小圆点（装饰用）
    function drawDot(x, y, r, color) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
    }

    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      canvas.style.width = rect.width + 'px';
      canvas.style.height = rect.height + 'px';
      ctx.scale(dpr, dpr);
    }

    class StarItem {
      constructor(w, h) {
        this.x = Math.random() * w;
        this.y = Math.random() * h;
        this.type = Math.random() > 0.85 ? 'moon' : (Math.random() > 0.7 ? 'cloud' : 'star');
        this.size = this.type === 'moon' ? 12 + Math.random() * 8 : (this.type === 'cloud' ? 0.6 + Math.random() * 0.4 : 2 + Math.random() * 3);
        this.vx = (Math.random() - 0.5) * 0.15;
        this.vy = (Math.random() - 0.5) * 0.15;
        this.rotation = Math.random() * Math.PI * 2;
        this.rotSpeed = (Math.random() - 0.5) * 0.002;
        this.opacity = 0.3 + Math.random() * 0.5;
        this.twinklePhase = Math.random() * Math.PI * 2;
        this.twinkleSpeed = 0.005 + Math.random() * 0.01;
      }
      update(w, h) {
        this.x += this.vx;
        this.y += this.vy;
        this.rotation += this.rotSpeed;
        this.twinklePhase += this.twinkleSpeed;
        if (this.x < -20) this.x = w + 20;
        if (this.x > w + 20) this.x = -20;
        if (this.y < -20) this.y = h + 20;
        if (this.y > h + 20) this.y = -20;
      }
      draw() {
        const twinkle = 0.5 + 0.5 * Math.sin(this.twinklePhase);
        const currentOpacity = this.opacity * twinkle;
        if (this.type === 'star') {
          drawHandDrawnStar(this.x, this.y, this.size, this.rotation, currentOpacity);
        } else if (this.type === 'moon') {
          drawHandDrawnMoon(this.x, this.y, this.size);
        } else if (this.type === 'cloud') {
          drawLittleCloud(this.x, this.y, this.size);
        }
      }
    }

    function initItems() {
      const w = canvas.width / dpr;
      const h = canvas.height / dpr;
      items = [];
      const count = Math.min(35, Math.floor((w * h) / 25000)); // 根据面积自适应数量
      for (let i = 0; i < count; i++) {
        items.push(new StarItem(w, h));
      }
      // 额外添加一些静态小圆点装饰
      const dotCount = Math.min(15, Math.floor((w * h) / 60000));
      for (let i = 0; i < dotCount; i++) {
        const dot = new StarItem(w, h);
        dot.type = 'dot';
        dot.size = 1 + Math.random() * 1.5;
        dot.vx *= 0.3;
        dot.vy *= 0.3;
        items.push(dot);
      }
    }

    function animate() {
      if (!isActive) return;
      const w = canvas.width / dpr;
      const h = canvas.height / dpr;
      ctx.clearRect(0, 0, w, h);
      items.forEach(item => {
        item.update(w, h);
        if (item.type === 'dot') {
          const twinkle = 0.4 + 0.6 * Math.sin(item.twinklePhase);
          drawDot(item.x, item.y, item.size, `rgba(215, 179, 190, ${item.opacity * twinkle * 0.6})`);
        } else {
          item.draw();
        }
      });
      animationId = requestAnimationFrame(animate);
    }

    function onResize() {
      resize();
      initItems();
    }
    window.addEventListener('resize', onResize);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        isActive = false;
        if (animationId) cancelAnimationFrame(animationId);
      } else {
        isActive = true;
        animate();
      }
    });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      isActive = false;
      return;
    }

    resize();
    initItems();
    animate();
  })();
</script>

<style>
  .star-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>
