---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { tagClass } from '../lib/tags';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL;
const href = withBase(`projects/${project.slug}`, base);
---

<a href={href} class="project-card fade-up">
  <div class="meta">
    <span class="date">{data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short' })}</span>
    <span class="sep">·</span>
    <span class="role">{data.role}</span>
  </div>
  <h3 class="title">{data.title}</h3>
  <p class="desc">{data.description}</p>
  <div class="tags">
    {data.tags.slice(0, 4).map((tag) => <span class={tagClass(tag)}>{tag}</span>)}
  </div>
  <div class="links">
    {data.liveUrl && <span class="link-badge">线上</span>}
    {data.repoUrl && <span class="link-badge">源码</span>}
    {data.documents?.length > 0 && <span class="link-badge">文档</span>}
    {data.externalDocs?.length > 0 && <span class="link-badge">飞书</span>}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
  }
  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .project-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 8px 32px rgba(107, 91, 149, 0.08), var(--shadow-hover);
    transform: translateY(-3px);
  }
  .project-card:hover::before {
    opacity: 0.6;
  }
  .project-card .tags .tag {
    /* 项目卡片标签使用莫兰迪统一色系 */
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.72rem;
  }
  .meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sep { opacity: 0.6; }
  .title {
    font-size: 1.05rem;
    line-height: 1.45;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .desc {
    color: var(--color-text-soft);
    font-size: 0.88rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .links {
    display: flex;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px solid var(--color-border);
  }
  .link-badge {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
</style>
