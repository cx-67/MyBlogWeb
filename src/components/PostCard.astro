---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { tagClass } from '../lib/tags';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { data } = post;
const base = import.meta.env.BASE_URL;
const href = withBase(`posts/${post.slug}`, base);
---

<a href={href} class="post-card fade-up">
  <h3 class="title">{data.title}</h3>
  <p class="desc">{data.description}</p>
  <div class="tags">
    {data.tags.map((tag) => <span class={tagClass(tag)}>{tag}</span>)}
  </div>
  <span class="date">{data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
  }
  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .post-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 8px 32px rgba(107, 91, 149, 0.08), var(--shadow-hover);
    transform: translateY(-3px);
  }
  .post-card:hover::before {
    opacity: 0.6;
  }
  .post-card .tags .tag {
    /* 文章卡片标签使用莫兰迪统一色系 */
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.72rem;
  }
  .title {
    font-size: 1.05rem;
    line-height: 1.45;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .desc {
    color: var(--color-text-soft);
    font-size: 0.88rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px solid var(--color-border);
  }
</style>
